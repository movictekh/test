#!/usr/bin/env bash

set -euo pipefail

SRC="/home/kachy/project/bomach/test/bomach_os_backend/"
DEST="/home/kachy/project/bomach/bomach_os_backend/"
EXCLUDES=(
  --exclude '.git/'
  --exclude '.venv/'
  --exclude '.env'
  --exclude 'db.sqlite3'
  --exclude 'mediafiles/'
  --exclude '__pycache__/'
  --exclude '.pytest_cache/'
  --exclude '.mypy_cache/'
  --exclude '.ruff_cache/'
  --exclude '.coverage'
  --exclude '.coverage.*'
  --exclude 'htmlcov/'
  --exclude '.DS_Store'
  --exclude 'sync'
  --exclude 'sync-prod'
)

echo "Source:      $SRC"
echo "Destination: $DEST"
echo

rsync -a --delete "${EXCLUDES[@]}" "$SRC" "$DEST"

echo
echo "Sync complete."
echo
git -C "$DEST" status --short
